DATABASE_URL=postgresql://forgepilot:forgepilot@localhost:5432/forgepilot
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# Optional social sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional AI features
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# GitHub App (repository access and webhooks). See README for setup.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# PEM contents; newlines may be written as \n on one line.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Optional background queue; without it jobs run inline. With it, run
# `npm run worker` next to the web server.
REDIS_URL=
# Protects /api/cron/<job> for schedulers when the worker is not used.
CRON_SECRET=
